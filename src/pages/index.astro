---
import '../styles/global.css';
import manPcx from '../assets/man-pcx.webp';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tri — Software Engineer</title>
</head>

<body id="top">

  <div class="container">

    <!-- HEADER -->
    <header>
      <a href="/" class="logo">Tri Mulyanto</a>
      <div class="eyebrow">Software Engineer · Indonesia</div>
    </header>


    <!-- HERO / ABOUT -->
    <main>

      <section class="hero" id="about">

        <div class="hero-content">

          <p class="intro">
            <strong>Hi! I’m Tri</strong>, a software engineer who enjoys building things and figuring out how technology can be made <strong>simpler, smarter, and more useful.</strong> Currently, I work at <strong><a href="https://alfagift.id" target="_blank">Alfagift</a></strong>, where I build backend systems, working with technologies like MongoDB, Redis and Apache Solr powering data, search experiences and turning ideas into reliable software.
          </p>

          <p class="intro">
            Recently, I’ve been exploring <strong>AI engineering</strong>, especially the intersection of LLMs, search, and backend systems. I enjoy experimenting with things like Spring AI, MCP, RAG, and AI-powered search — mostly because I’m curious about what happens when traditional software engineering meets AI.
          </p>

          <p class="intro">
            I’m also interested in the web, developer tools, and the craft of building software that is simple, useful, and enjoyable to use.
          </p>

          <p class="intro">
            Outside of code, I’m a husband to my incredible wife, a father to four wonderful daughters, and a <strong>die-hard Manchester United fan</strong>. lol.
          </p>

          <p class="intro">
            <strong>Build. Learn. Experiment. Repeat.</strong>
          </p>

        </div>


        <!-- ILLUSTRATION -->
        <img class="illustration" src={manPcx.src} alt="Illustration of Tri Mulyanto" />

        <div class="hero-bottom">
          <div class="links">
            <a href="https://github.com/ghemulyanto" target="_blank">
              GitHub ↗
            </a>

            <a href="https://www.linkedin.com/in/tri-mulyanto-2874b531/" target="_blank">
              LinkedIn ↗
            </a>

            <a href="mailto:trimulyanto.tm@gmail.com">
              Email ↗
            </a>
          </div>

          <nav class="side-nav">
            <a href="#experience">Experience</a>
          </nav>
        </div>

      </section>


      <!-- EXPERIENCE -->
      <section class="experience" id="experience">

        <div class="experience-header">
          <div class="section-label">
            Experience
          </div>
          <nav class="side-nav">
            <a href="#top">About</a>
          </nav>
        </div>

        <article class="experience-item">

          <div class="date">
            2022 — Present
          </div>

          <div>

            <h2 class="job-title">
              Software Engineer
              <span class="company">· <a href="https://alfagift.id" target="_blank">Alfagift</a></span>
            </h2>

            <p class="description">
              Building and improving backend services that
              support data, search, and shopping experiences.
              My work involves designing services, improving
              existing systems, experimenting with search
              technologies, and exploring how AI can make
              product discovery more useful.
            </p>

            <div class="tech">
              <span>Java</span>
              <span>Spring Boot</span>
              <span>MongoDB</span>
              <span>Redis</span>
              <span>Kafka</span>
              <span>Google Pub/Sub</span>
              <span>Apache Solr</span>
              <span>AI / LLM</span>
            </div>

          </div>

        </article>

        <article class="experience-item">

          <div class="date">
            2018 — 2021
          </div>

          <div>

            <h2 class="job-title">
              Software Engineer & Team Lead
              <span class="company">· <a href="https://www.telkomsigma.co.id" target="_blank">Telkomsigma</a></span>
            </h2>

            <p class="description">
              Started as a software engineer and grew into a team lead for the nationwide SPBU (gas station) digitalization project. I designed and maintained backend services and data pipelines, coordinated with stakeholders, and helped the team.
            </p>

            <div class="tech">
              <span>Java</span>
              <span>Spring Boot</span>
              <span>Golang</span>
              <span>MongoDB</span>
              <span>MariaDB</span>
              <span>Apache NiFi</span>
            </div>

          </div>

        </article>

        <article class="experience-item">

          <div class="date">
            2015 — 2017
          </div>

          <div>

            <h2 class="job-title">
              Software Engineer
              <span class="company">· <a href="https://www.asyx.com" target="_blank">Asyx Indonesia</a></span>
            </h2>

            <p class="description">
              Built a supply chain financing platform that connects buyers, suppliers, and financial institutions. I developed backend services and web interfaces to automate financing workflows and streamline access to working capital for businesses.
            </p>

            <div class="tech">
              <span>Java</span>
              <span>Spring Boot</span>
              <span>Thymeleaf</span>
              <span>Apache Camel</span>
              <span>Elasticsearch</span>
              <span>Cassandra</span>
            </div>

          </div>

        </article>

      </section>

    </main>


    <!-- FOOTER -->
    <footer>

      <span>
        © 2026 Tri.
      </span>

      <span>
        Built with curiosity.
      </span>

    </footer>

  </div>

</body>
</html>
